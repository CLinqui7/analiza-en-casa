# Modo local inmediato: "mock". Para conectar Supabase: "supabase".
DATA_MODE=mock
NEXT_PUBLIC_DATA_MODE=mock

# URL pública del proyecto
APP_URL=http://localhost:4173
NEXT_PUBLIC_APP_URL=http://localhost:4173

# Supabase. La publishable/anon key puede exponerse al cliente; la service role NO.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Organización por defecto
DEFAULT_ORG_SLUG=analiza-en-casa-demo

# Comunicaciones
NOTIFICATIONS_MODE=mock
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_TOKEN=
EMAIL_PROVIDER=mock
EMAIL_API_URL=
EMAIL_API_TOKEN=

# Protección de tareas programadas
CRON_SECRET=cambie-este-secreto

# Portal del paciente
PORTAL_TOKEN_TTL_HOURS=72
PORTAL_OTP_TTL_MINUTES=10
