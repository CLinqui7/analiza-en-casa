{
  "name": "analiza-en-casa-production-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Sistema operativo de atención domiciliaria, preparado para Supabase y Vercel, con modo demo local.",
  "scripts": {
    "dev": "npm run dev --workspace=@analiza/web",
    "start": "npm run start --workspace=@analiza/web",
    "dev:legacy": "node scripts/serve.mjs",
    "start:legacy": "node scripts/serve.mjs",
    "build": "npm run build --workspace=@analiza/web",
    "typecheck": "npm run typecheck --workspace=@analiza/web",
    "lint": "npm run lint --workspace=@analiza/web",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "test:react": "npm run test --workspace=@analiza/web",
    "test": "node --test tests/*.test.mjs",
    "test:browser:ch01": "playwright test tests/e2e/ch01.spec.mjs",
    "test:browser:ch02": "playwright test tests/e2e/ch02.spec.mjs",
    "test:browser:ch03": "playwright test tests/e2e/ch03.spec.mjs",
    "test:browser:ch04": "playwright test tests/e2e/ch04.spec.mjs",
    "test:browser:ch05": "playwright test tests/e2e/ch05.spec.mjs",
    "test:browser:ch06": "playwright test tests/e2e/ch06.spec.mjs",
    "test:browser:ch07": "playwright test tests/e2e/ch07.spec.mjs",
    "test:browser:ch08": "playwright test tests/e2e/ch08.spec.mjs",
    "test:browser:ch09": "playwright test tests/e2e/ch09.spec.mjs",
    "test:browser:ch10": "playwright test tests/e2e/ch10.spec.mjs",
    "test:browser:ch11": "playwright test tests/e2e/ch11.spec.mjs",
    "test:browser:ch12": "playwright test tests/e2e/ch12.spec.mjs",
    "test:browser:ch13": "playwright test tests/e2e/ch13.spec.mjs",
    "test:browser:ch14": "playwright test tests/e2e/ch14.spec.mjs",
    "test:browser:ch15": "playwright test tests/e2e/ch15.spec.mjs",
    "test:browser:ch16": "playwright test tests/e2e/ch16.spec.mjs",
    "test:browser:react": "playwright test -c apps/web/playwright.config.ts",
    "test:selenium": "py tests/selenium/smoke.py",
    "test:selenium:patients": "py tests/selenium/test_patients.py",
    "test:selenium:patients:all": "py -m unittest discover -s tests/selenium -p test_patients.py -v",
    "qa": "node scripts/qa-check.mjs",
    "qa:local": "npm run codex:preflight && npm run security:scan && npm run check && npm run audit:verify && npm run react:boundaries && npm run typecheck && npm run lint && npm run format:check && npm run test:react && npm run test:browser:react && npm run test:selenium",
    "check": "npm test && npm run qa && npm run build:standalone",
    "build:standalone": "node scripts/build-standalone.mjs",
    "codex:preflight": "node scripts/codex-preflight.mjs",
    "github:preflight": "node scripts/github-preflight.mjs",
    "audit:status": "node scripts/audit-status.mjs",
    "audit:verify": "node scripts/verify-video-audit.mjs",
    "audit:master": "node scripts/generate-master-video-requirements.mjs",
    "audit:master:bootstrap": "node scripts/generate-master-video-requirements.mjs --bootstrap",
    "parity:generate": "node scripts/generate-exact-parity-matrices.mjs",
    "inventory:generate": "node scripts/generate-functional-inventories.mjs",
    "react:boundaries": "node scripts/check-react-boundaries.mjs",
    "react:parity": "node scripts/verify-react-route-parity.mjs",
    "qa:inventory": "node scripts/render-ui-action-inventory.mjs",
    "selenium:coverage": "node scripts/verify-selenium-coverage.mjs",
    "selenium:coverage:patients": "node scripts/verify-selenium-coverage.mjs --prefix PATIENT- --require-executed",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.6.2"
  }
}
