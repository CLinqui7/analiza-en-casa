{
  "name": "analiza-en-casa-production-qa",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Analiza full-stack Next.js: Cloud Run, PostgreSQL 18 y archivos privados GCS; QA sintético.",
  "scripts": {
    "dev": "npm run dev --workspace=@analiza/web",
    "start": "npm run start --workspace=@analiza/web",
    "dev:legacy": "node scripts/serve.mjs",
    "start:legacy": "node scripts/serve.mjs",
    "build": "npm run build --workspace=@analiza/web",
    "typecheck": "npm run typecheck --workspace=@analiza/web",
    "lint": "npm run lint --workspace=@analiza/web",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "test:react": "npm run test --workspace=@analiza/web",
    "test:core:mongo": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/server/core-live-verification.ts",
    "test:core:selenium": "node scripts/verify-core-selenium.mjs",
    "docker:build": "docker build --progress=plain -t analiza-web:cloudrun .",
    "docker:bootstrap:build": "docker build --target operator -t analiza-operator:postgresql .",
    "test": "node --test tests/*.test.mjs",
    "test:browser:ch01": "playwright test tests/e2e/ch01.spec.mjs",
    "test:browser:ch02": "playwright test tests/e2e/ch02.spec.mjs",
    "test:browser:ch03": "playwright test tests/e2e/ch03.spec.mjs",
    "test:browser:ch04": "playwright test tests/e2e/ch04.spec.mjs",
    "test:browser:ch05": "playwright test tests/e2e/ch05.spec.mjs",
    "test:browser:ch06": "playwright test tests/e2e/ch06.spec.mjs",
    "test:browser:ch07": "playwright test tests/e2e/ch07.spec.mjs",
    "test:browser:ch08": "playwright test tests/e2e/ch08.spec.mjs",
    "test:browser:ch09": "playwright test tests/e2e/ch09.spec.mjs",
    "test:browser:ch10": "playwright test tests/e2e/ch10.spec.mjs",
    "test:browser:ch11": "playwright test tests/e2e/ch11.spec.mjs",
    "test:browser:ch12": "playwright test tests/e2e/ch12.spec.mjs",
    "test:browser:ch13": "playwright test tests/e2e/ch13.spec.mjs",
    "test:browser:ch14": "playwright test tests/e2e/ch14.spec.mjs",
    "test:browser:ch15": "playwright test tests/e2e/ch15.spec.mjs",
    "test:browser:ch16": "playwright test tests/e2e/ch16.spec.mjs",
    "test:browser:react": "playwright test -c apps/web/playwright.config.ts",
    "test:browser:quotes": "playwright test -c apps/web/playwright.config.ts e2e/quotes.spec.ts",
    "test:selenium": "py tests/selenium/smoke.py",
    "test:selenium:all": "node scripts/run-selenium.mjs",
    "test:selenium:patients": "py tests/selenium/test_patients.py",
    "test:selenium:patients:all": "py -m unittest discover -s tests/selenium -p test_patients.py -v",
    "test:selenium:hospitalizations": "py tests/selenium/test_hospitalizations.py",
    "test:selenium:hospitalizations:all": "py -m unittest discover -s tests/selenium -p test_hospitalizations.py -v",
    "test:selenium:quotes": "py tests/selenium/test_quotes.py",
    "test:selenium:quotes:all": "py -m unittest discover -s tests/selenium -p test_quotes.py -v",
    "qa": "node scripts/qa-check.mjs",
    "qa:local": "npm run repo:preflight && npm run security:scan && npm run check && npm run audit:verify && npm run react:boundaries && npm run typecheck && npm run lint && npm run format:check && npm run test:react && npm run test:browser:react && npm run test:selenium",
    "check": "npm test && npm run qa && npm run build:standalone",
    "build:standalone": "node scripts/build-standalone.mjs",
    "github:preflight": "node scripts/github-preflight.mjs",
    "audit:status": "node scripts/audit-status.mjs",
    "audit:verify": "node scripts/verify-video-audit.mjs",
    "audit:master": "node scripts/generate-master-video-requirements.mjs",
    "audit:master:bootstrap": "node scripts/generate-master-video-requirements.mjs --bootstrap",
    "parity:generate": "node scripts/generate-exact-parity-matrices.mjs",
    "inventory:generate": "node scripts/generate-functional-inventories.mjs",
    "react:boundaries": "node scripts/check-react-boundaries.mjs",
    "react:parity": "node scripts/verify-react-route-parity.mjs",
    "qa:inventory": "node scripts/render-ui-action-inventory.mjs",
    "qa:video-parity:generate": "node scripts/generate-video-react-traceability.mjs",
    "qa:video-parity": "node scripts/verify-video-react-parity.mjs",
    "qa:video-parity:chapter": "node scripts/verify-video-react-parity.mjs --chapter",
    "qa:video-parity:report": "node scripts/report-video-react-parity.mjs",
    "qa:traceability-mirror": "node scripts/verify-video-traceability-mirror.mjs",
    "qa:client-changes:generate": "node scripts/generate-client-change-registry.mjs",
    "qa:client-changes": "node scripts/verify-client-changes.mjs --self-test",
    "qa:client-changes:report": "node scripts/report-client-changes.mjs",
    "qa:client-changes:batch": "node scripts/verify-client-changes.mjs --self-test --batch",
    "qa:light-mode": "node scripts/verify-light-mode.mjs",
    "perf:baseline": "npm run build && node scripts/perf-production.mjs baseline",
    "perf:check": "npm run build && node scripts/perf-production.mjs final",
    "perf:report": "npm run build && node scripts/perf-production.mjs final",
    "selenium:coverage": "node scripts/verify-selenium-coverage.mjs",
    "selenium:coverage:patients": "node scripts/verify-selenium-coverage.mjs --prefix PATIENT- --require-executed",
    "selenium:coverage:ch01": "node scripts/verify-selenium-ch01-coverage.mjs",
    "selenium:coverage:ch02": "node scripts/verify-selenium-ch02-coverage.mjs",
    "selenium:coverage:hospitalizations": "node scripts/verify-selenium-hospitalization-coverage.mjs",
    "selenium:coverage:ch03": "node scripts/verify-selenium-ch03-coverage.mjs",
    "selenium:coverage:quotes": "node scripts/verify-selenium-quote-coverage.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "db:plan": "node scripts/deployment/db-command.mjs --dry-run",
    "db:migrate": "node scripts/deployment/db-command.mjs --migrate",
    "db:plan:mongo": "node scripts/deployment/mongo-command.mjs --dry-run",
    "db:migrate:mongo": "node scripts/deployment/mongo-command.mjs --migrate",
    "deploy:preview": "node scripts/deployment/deploy-vercel-preview.mjs",
    "test:registration:mongo": "tsx --tsconfig apps/web/tsconfig.json scripts/verify-account-registration.ts",
    "test:registration:browser": "playwright test -c apps/web/playwright.registration.config.ts",
    "db:seed:qa": "node scripts/deployment/db-command.mjs --seed-synthetic",
    "test:postgresql": "node scripts/deployment/verify-container.mjs",
    "test:ubuntu:selfhosted": "node scripts/deployment/verify-ubuntu-selfhosted.mjs",
    "repo:preflight": "node scripts/repository-preflight.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
