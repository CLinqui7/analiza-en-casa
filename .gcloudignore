# Cloud Build uploads use this file independently of Docker's build context.
.gcloudignore
.git
.git/**
**/.env*
**/node_modules
**/.next
**/.vercel
**/.local
**/.analiza-runtime
**/.codex
**/.codex-log
**/.qa-results
**/.npm-cache
**/.config/gcloud
**/.aws
**/.azure
**/.ssh
**/.npmrc
**/*credentials*
**/*service-account*.json
**/*service_account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.dump
**/*.bson
**/*.bak
**/*.tar
**/*.gz
**/*.zip
**/*.7z
**/*.sqlite*
**/*.db
**/storage-state*.json
**/auth-state*.json
**/*.log
**/*.tsbuildinfo
**/__pycache__
**/coverage
**/test-results
**/playwright-report
**/*.mp4
references
video-audit-reviews
standalone
docs/client-change-requests/source
**/.terraform
**/*.tfstate*
**/*.tfplan
**/*.tfvars
# docs/qa, docs/parity, app, api and supabase are required by build/unit tests.
